{
  "id": "design-golden-v1",
  "name": "Design Golden V1",
  "version": "1.1.0",
  "description": "跨模式 golden：文档结构关键字段（exact_match）+ 计划合理性/回答质量（LLM Judge）。3 个 fixture 回放用例 + 8 个在线真跑用例。",
  "metrics": [
    {
      "id": "doc_structure",
      "name": "文档结构关键字段",
      "kind": "exact_match",
      "passThreshold": 1
    },
    {
      "id": "plan_reasonableness",
      "name": "计划合理性",
      "kind": "llm_judge",
      "criteria": "评估输出是否构成合理的游戏设计方案：目标清晰、系统拆分合理、有可落地的数值或机制要点。分数 0-1。",
      "passThreshold": 0.6
    },
    {
      "id": "answer_quality",
      "name": "回答质量",
      "kind": "llm_judge",
      "criteria": "评估回答是否准确、完整、切题：正面回答用户问题，给出关键信息；与问题无关或明显错误应给低分。分数 0-1。",
      "passThreshold": 0.6
    }
  ],
  "cases": [
