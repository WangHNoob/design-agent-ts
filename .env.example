# LLM Configuration
LLM_API_KEY=sk-your-api-key-here
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus
LLM_BASE_URL=https://api.nagara.top

# Framework
AGENT_FRAMEWORK=langgraph

# HITL (Human-in-the-loop)
HITL_ENABLED=false
HITL_MAX_REVISIONS=10
HITL_TIMEOUT=300000
HITL_AUTO_CONTINUE=false

# Knowledge paths
KNOWLEDGE_WIKI_PATH=./knowledge/wiki
KNOWLEDGE_GRAPH_PATH=./knowledge/wiki

# Web Search (Tavily)
TAVILY_ENABLED=false
TAVILY_API_KEY=tvly-your-api-key-here

# Long-Term Memory (LTM)
# Enables cross-session memory: semantic (facts), episodic (experiences),
# procedural (workflows), and profile (user preferences) memories.
LTM_ENABLED=false
LTM_STORAGE_PATH=./data/long-term-memory
LTM_DEFAULT_NAMESPACE=global
LTM_MAX_CONTEXT_MEMORIES=10
LTM_MIN_IMPORTANCE=0.4
LTM_AUTO_EXTRACT=true
LTM_AUTO_PRUNE=true
LTM_MAX_AGE_MS=2592000000
LTM_PRUNE_BELOW_IMPORTANCE=0.3

# Server
PORT=4527

# Agent & Tool Limits
SUB_AGENT_MAX_ITERATIONS=20
QUERY_AGENT_MAX_ITERATIONS=20
ITERATION_BUDGET_DEFAULT=25
CONTEXT_MAX_TOKENS=200000
CONTEXT_COMPRESSION_THRESHOLD=0.8
TAVILY_MAX_RESULTS=50
GREP_SEARCH_RESULT_LIMIT=20
WEB_SOURCE_RESULT_LIMIT=10
SESSION_LIST_LIMIT=500
MODEL_MAX_TOKENS=65536

# Redis (reserved for future use, e.g. session cache, distributed lock)
# Note: When using docker-start.mjs --infra, Redis runs on port 16379 to avoid conflicts
REDIS_URL=redis://localhost:16379/0

# ─── User System (Multi-Tenant) ───────────────────────────────────
# When enabled, all data (sessions, memory, settings, skills, workflows)
# is isolated per user. Requires PostgreSQL + Redis.
USER_SYSTEM_ENABLED=false
JWT_SECRET=change-me-in-production
JWT_TTL_MS=86400000
MAX_CONCURRENT_PER_USER=3

# PostgreSQL connection
POSTGRES_URL=postgresql://postgres:postgres@localhost:15432/game_designer

# Auto-initialize database schema on startup (safe: uses IF NOT EXISTS)
AUTO_INIT_SCHEMA=true

# ─── Message Queue ─────────────────────────────────────────────────
# When enabled, agent tasks are dispatched via Redis Streams for
# async execution and better concurrency control.
MQ_ENABLED=false
MQ_CONSUMER_GROUP=gd-workers
MQ_POLL_INTERVAL_MS=100
