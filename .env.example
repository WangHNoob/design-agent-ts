# LLM Configuration
LLM_API_KEY=sk-your-api-key-here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1  # Optional, for openai-compatible providers

# Framework
AGENT_FRAMEWORK=langgraph

# HITL (Human-in-the-loop)
HITL_ENABLED=false
HITL_MAX_REVISIONS=3
HITL_TIMEOUT=300000
HITL_AUTO_CONTINUE=false

# Knowledge paths
KNOWLEDGE_WIKI_PATH=./knowledge/wiki
KNOWLEDGE_GRAPH_PATH=./knowledge/processed

# Web Search (Tavily)
TAVILY_ENABLED=false
TAVILY_API_KEY=tvly-your-api-key-here

# Server
PORT=3000
