# ─── LLM 配置 ──────────────────────────────────────────────────────
# Docker 会把本文件与 settings.json 挂载进 backend；在设置页保存后会写回此处，
# 重建镜像后无需重新填写。settings.json 优先于下方环境变量。
LLM_API_KEY=sk-your-api-key-here
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus
LLM_BASE_URL=https://api.nagara.top
# 备选模型（逗号分隔，默认沿用主模型的 provider/key/baseUrl）；主模型超时/429/连续失败时自动切换
# 例：LLM_FALLBACK_MODELS=claude-sonnet,gpt-4o-mini
LLM_FALLBACK_MODELS=
# 连续可重试失败次数达到阈值后打开该模型熔断（默认 3）
LLM_FALLBACK_FAILURE_THRESHOLD=3
# 熔断冷却毫秒（默认 60000）
LLM_FALLBACK_COOLDOWN_MS=60000

# ─── 框架 ──────────────────────────────────────────────────────────
AGENT_FRAMEWORK=langgraph
# 无真实 LLM 的 Docker 压测：设 AGENT_FRAMEWORK=mock，并保证 LLM_API_KEY 非空占位，
# 否则 POST /api/console/execute 返回 409 not_configured。详见 loadtest/README.md
# 与 loadtest/.env.loadtest.example

# ─── HITL (人工介入) ───────────────────────────────────────
# 全局 HITL 开关：控制 plan/agent-output/final 等标准审阅点
HITL_ENABLED=false
HITL_MAX_REVISIONS=10
HITL_TIMEOUT=300000
HITL_AUTO_CONTINUE=false
# 超时策略：auto_reject（默认，可审计拒绝）| auto_approve（可审计通过）| expire（作废）| escalate（升级仍等人）
HITL_TIMEOUT_POLICY=auto_reject
# 超时扫表间隔（ms）；0=关闭扫表
HITL_TIMEOUT_SWEEP_INTERVAL_MS=15000
# 审阅分布式锁 TTL（ms）、超时扫表每批处理条数
HITL_REVIEW_LOCK_TTL_MS=30000
HITL_SWEEP_BATCH_SIZE=50

# ─── 知识库路径 ────────────────────────────────────────────────────
KNOWLEDGE_WIKI_PATH=./knowledge/wiki
KNOWLEDGE_GRAPH_PATH=./knowledge/wiki

# ─── 网络搜索 (Tavily) ─────────────────────────────────────────────
TAVILY_ENABLED=false
TAVILY_API_KEY=tvly-your-api-key-here

# ─── 长期记忆 (LTM) ────────────────────────────────────────────────
# 启用跨会话记忆：包括语义记忆（事实）、情景记忆（经历）、
# 程序记忆（工作流）以及画像记忆（用户偏好）。数据存储在 PostgreSQL。
LTM_ENABLED=true
LTM_DEFAULT_NAMESPACE=global
LTM_MAX_CONTEXT_MEMORIES=10
LTM_MIN_IMPORTANCE=0.4
LTM_AUTO_EXTRACT=true
LTM_AUTO_PRUNE=true
LTM_MAX_AGE_MS=2592000000
LTM_PRUNE_BELOW_IMPORTANCE=0.3

# ─── 服务器 ────────────────────────────────────────────────────────
PORT=4527

# ─── 智能体与工具限制 ───────────────────────────────────────────────
SUB_AGENT_MAX_ITERATIONS=20
QUERY_AGENT_MAX_ITERATIONS=20
ITERATION_BUDGET_DEFAULT=25
CONTEXT_MAX_TOKENS=200000
CONTEXT_COMPRESSION_THRESHOLD=0.8
# 短时记忆滑窗：驱逐前摘要入归档（不论是否超 token 预算）
MEMORY_ARCHIVE_ENABLED=true
# 保护最近 N 条非 system 消息原文（按消息条数，不是 user/assistant 对话轮）
MEMORY_PROTECT_RECENT_TURNS=10
# 活跃非 system 消息超过此数量时强制驱逐（即使未超 token 预算）
MEMORY_MAX_ACTIVE_MESSAGES=40
# 归档摘要器：heuristic（默认，无 LLM）| llm（LLMSummarizerAdapter，opt-in——
# 启用前须跑 scripts/compare-summarizers.mjs 小实验对比，见 flywheel-plans/01 Phase 3）
MEMORY_SUMMARIZER=heuristic
# LLM 摘要器输出 token 上限（MEMORY_SUMMARIZER=llm 时生效）
MEMORY_SUMMARIZER_MAX_OUTPUT_TOKENS=800
# SSE 心跳 comment 帧间隔（毫秒）；0 关闭
SSE_HEARTBEAT_MS=15000
TAVILY_MAX_RESULTS=50
GREP_SEARCH_RESULT_LIMIT=20
WEB_SOURCE_RESULT_LIMIT=10
SESSION_LIST_LIMIT=500
MODEL_MAX_TOKENS=65536
# Query 模式单次 LLM 输出 token 上限（默认 1024；2G 单进程部署建议保持默认或更低）
QUERY_MAX_TOKENS=1024

# ─── 共享黑板（多 Agent 协作时缓存工具/联网调用结果，避免重复调用）────────
# 总开关，设为 false 退回无缓存行为
BLACKBOARD_ENABLED=true
# 检索类工具与 blackboard_write 的默认 TTL（秒）
BLACKBOARD_DEFAULT_TTL=300
# 联网类工具（tavily / kb_*）的 TTL（秒）
BLACKBOARD_WEB_TTL=600
# 每个子任务启动时注入的近期黑板要点条数
BLACKBOARD_RECENT_INJECT=5
# 启用透明缓存的工具名白名单（逗号分隔；留空使用默认；kb_* MCP 工具自动追加）
# 默认：tavily_search,tavily_extract,grep_search,kg_query_node,kg_query_neighbors,kg_list_nodes
BLACKBOARD_CACHED_TOOLS=

# ─── Agent Trace 观测（Session / Trace / Span 落库）────────────────
# 默认开启；写入 Postgres agent_trace_* 表，Span 写入即不可变
TRACING_ENABLED=true
# 开发辅助：将完成的 Span 额外打到 stdout（默认关闭）
TRACING_CONSOLE_EXPORTER=false
# 单个 span 属性值最大字符数（工具入参/出参、LLM 思考/输出预览截断阈值）
TRACING_ATTR_MAX_CHARS=1500

# ─── 运行时硬护栏（Token 预算 / 工具死循环 / 工具熔断）──────────────
# 单次 Trace（一次 Director 执行）累计 input+output token 硬上限；0=关闭
TRACE_TOKEN_BUDGET=500000
# 最近 K 次工具调用窗口；同工具同参重复达阈值则强制中断
TOOL_LOOP_WINDOW_SIZE=8
TOOL_LOOP_MAX_REPEATS=3
# 外部/MCP 工具连续失败达阈值后熔断（Closed→Open），冷却后 Half-Open 探测
TOOL_CIRCUIT_FAILURE_THRESHOLD=3
TOOL_CIRCUIT_COOLDOWN_MS=60000
# 外部工具默认重试次数与退避基数（ms，指数退避）
TOOL_RETRY_MAX_ATTEMPTS=2
TOOL_RETRY_BACKOFF_MS=200
# 外部/MCP 单次调用超时（ms）；0=关闭
TOOL_TIMEOUT_MS=30000
# 单条工具结果进入模型上下文的最大字符数（0=不截断）；长 KB envelope 的上下文预算兜底
TOOL_RESULT_MAX_CHARS=6000
# Plan 硬保障：步骤推进/工具白名单/最大重规划（范式二外部编排）
# 默认开启；设为 false 关闭白名单拦截与重规划预算
PLAN_HARD_ENABLED=true
# 步骤失败后最多重规划次数（替换剩余步骤）；0=禁止重规划
PLAN_MAX_REPLANS=2
# 越权工具调用 fail loud（ToolResult.error + Trace）；默认 true
PLAN_REJECT_UNAUTHORIZED_TOOLS=true
# 可选：按 domain 覆盖默认工具白名单（JSON），如 {"qa":["wiki_page","grep_search"]}
PLAN_DOMAIN_TOOL_DEFAULTS={}
# 多 Agent 失控防护（范式三）：全局 Token / fan-out / 深度 / 环检测 / Handoff
# 默认开启；设为 false 关闭 fan-out 分批、调用栈守卫与 Handoff 硬校验
MULTI_AGENT_ENABLED=true
# 同 root Trace 下所有子 Agent 共用的独立 Token 硬预算；0=禁用独立预算（仍受 TRACE_TOKEN_BUDGET 约束）
# 未设置时默认等于 TRACE_TOKEN_BUDGET
MULTI_AGENT_TOKEN_BUDGET=500000
# 同层并行 fan-out 上限；超出则分批 Promise.all（不硬拒绝）
MULTI_AGENT_MAX_FAN_OUT=8
# Director→子 Agent 调用栈深度上限（Director=0，首层子 Agent=1）
MULTI_AGENT_MAX_DEPTH=3
# Agent 调用图环检测（A→B→A）；默认开启
MULTI_AGENT_DETECT_CYCLES=true
# Handoff 蒸馏结论最大字符数 / 要点条数
HANDOFF_MAX_CHARS=4000
HANDOFF_MAX_KEY_POINTS=12
# 注入下游时多前驱 Handoff 合计字符上限；0=不限制合计
HANDOFF_MAX_TOTAL_CHARS=12000
# 子 Agent 是否注册 invoke_agent（Agent-as-Tool，受深度/环守卫）；默认 true
MULTI_AGENT_ALLOW_INVOKE=true

# ─── 安全：审计 / 工具分级 / 不可逆 HITL / 参数沙箱 ───────────────
# 审计日志落库（audit_logs）；默认开启
SECURITY_AUDIT_ENABLED=true
# Saga 补偿：副作用工具失败/取消时逆序 compensate；补偿失败写入 audit_logs
SAGA_COMPENSATE_ENABLED=true
SAGA_COMPENSATE_FAILURE_TO_AUDIT=true
# 不可逆工具默认强制 HITL 审批；未审批不可执行
# 注意：不可逆工具审批独立于 HITL_ENABLED；只要本项为 true 且配置了 hitlRepository，就会创建 hitl-tool-irreversible checkpoint
SECURITY_IRREVERSIBLE_REQUIRE_HITL=true
# 显式不可逆工具名（逗号分隔），如 test_delete_file
SECURITY_IRREVERSIBLE_TOOL_NAMES=
# 工具名按 _/- 分词后整词匹配以下关键字时视为 irreversible（逗号分隔）
SECURITY_IRREVERSIBLE_NAME_KEYWORDS=delete,drop,rm
# 工具风险级别覆盖（JSON），如 {"my_tool":"write","danger_delete":"irreversible"}
SECURITY_TOOL_RISK_OVERRIDES={}
# 参数沙箱：拒绝的危险关键字（逗号分隔）
TOOL_SANDBOX_DENY_KEYWORDS=DROP TABLE,DELETE FROM,rm -rf,eval(,exec(
# 参数沙箱：拒绝路径穿越与绝对路径；默认 true
TOOL_SANDBOX_BLOCK_PATH_TRAVERSAL=true

# ─── Token 用量计量 + RPM/TPM 限流（每用户隔舱；不计费）──────────────
# 用户自配 LLM（BYOK），平台不估算美元成本；仅记录 token 并做速率护栏。
# 默认开启；写入 Postgres cost_usage 表（estimated_cost_micros 恒为 0）
COST_ENABLED=true
# 每用户 RPM/TPM 上限（0=关闭该项）；Redis 后端为固定窗口（COST_WINDOW_MS，默认 60s）
COST_RPM_LIMIT_PER_USER=60
COST_TPM_LIMIT_PER_USER=200000
COST_WINDOW_MS=60000
# 全站 soft cap（0=关闭）；与每用户限额独立 key，防止单用户吃满全局
COST_GLOBAL_RPM_LIMIT=0
COST_GLOBAL_TPM_LIMIT=0
# pre_reasoning TPM 预检时的估算 token 数
COST_TPM_ESTIMATE_PER_CALL=8000

# ─── Eval V1（Offline golden / LLM-as-Judge）────────────────────────
# 默认 golden 数据集路径（相对仓库根）
EVAL_DEFAULT_DATASET=eval/datasets/design-golden.v1.json
# Offline 脚本默认只跑 exact_match（true），避免 CI 依赖 LLM Key；设 false 时包含 llm_judge
EVAL_OFFLINE_EXACT_ONLY=true

# ─── Redis（必需：会话缓存、分布式锁与消息队列）──────────────────────
# 注意：当使用 docker-start.mjs --infra 时，Redis 运行在 16379 端口以避免冲突
REDIS_URL=redis://localhost:16379/0

# ─── 用户系统 (多租户) ─────────────────────────────────────────────
# 所有数据（会话、记忆、设置、技能、工作流）都会按用户进行隔离。
# PostgreSQL、Redis 与 Better Auth 均为运行硬依赖。
# 身份验证由 Better Auth 处理（基于 cookie 的会话）。
# 仅供本地开发；生产环境必须替换为独立的高熵密钥（至少 32 字符）。
BETTER_AUTH_SECRET=local-development-secret-32-characters
# 本地开发环境: http://localhost:4527
# Docker 环境: http://backend:3000 (Docker 内部网络)
# 云端部署: https://your-domain.com
BETTER_AUTH_BASE_URL=http://localhost:4527
MAX_CONCURRENT_PER_USER=3

# PostgreSQL 连接配置
# 本地开发环境: postgresql://user:pass@localhost:5432/game_designer
# Docker 环境: postgresql://game_designer:game_designer@postgres:5432/game_designer
POSTGRES_URL=postgresql://postgres:postgres@localhost:15432/game_designer

# PostgreSQL 凭证 (docker-compose 用来创建数据库)
POSTGRES_USER=game_designer
POSTGRES_PASSWORD=game_designer
POSTGRES_DB=game_designer
POSTGRES_PORT=5432

# ─── 管理员角色 (邮箱域名) ─────────────────────────────────────────
# 用逗号分隔的邮箱域名（不要填完整邮箱），注册时这些域名的用户会自动获得管理员角色。
# 例如 "company.com,corp.cn" → user@company.com 会自动升级为管理员。
# 错误示例："admin@admin.com"（会被当成域名字面量，永远匹配不上）。
# 正确示例：要让 admin@admin.com 成为管理员，应设为 ADMIN_EMAIL_DOMAINS=admin.com
# 系统不会预置管理员账号；请先在前端注册，再登录。
# 留空则禁用自动管理员功能。
ADMIN_EMAIL_DOMAINS=

# ─── 钉钉单点登录 (SSO) ───────────────────────────────────────────
# 请在 https://open-dev.dingtalk.com/ → 应用开发 中创建应用
# 将回调 URL (Callback URL) 设置为: https://your-domain.com/api/auth/oauth2/callback/dingtalk
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# 是否允许邮箱+密码登录 (若设置为 "false" 则强制仅使用 SSO 单点登录)
ALLOW_EMAIL_PASSWORD=true

# Better Auth 受信来源（逗号分隔，用于 CORS）。
# 必须包含前端的访问地址。base URL 会自动纳入，无需重复添加。
# 示例："http://localhost:3001,https://myapp.com"
TRUSTED_ORIGINS=http://localhost:3001
# Better Auth 会话有效期（秒，默认 7 天）与会话刷新窗口（秒，默认 1 天）
AUTH_SESSION_TTL_SECONDS=604800
AUTH_REFRESH_TTL_SECONDS=86400
# Redis 基础设施旋钮：分布式锁参数、租户上下文缓存 TTL（秒）、并发槽 TTL（秒）
REDIS_LOCK_WAIT_TIMEOUT_MS=5000
REDIS_LOCK_TTL_MS=30000
REDIS_LOCK_RETRIES=10
REDIS_LOCK_RETRY_DELAY_MS=500
REDIS_TENANT_CACHE_TTL_SECONDS=300
REDIS_CONCURRENCY_SLOT_TTL_SECONDS=3600

# ─── 消息队列 ──────────────────────────────────────────────────────
# 启用后，智能体任务将通过 Redis Streams 进行分发，
# 以实现异步执行和更好的并发控制。
MQ_ENABLED=true
MQ_CONSUMER_GROUP=gd-workers
# PEL 条目超过该时间后允许其他消费者回收
MQ_VISIBILITY_TIMEOUT_MS=30000
# 单次阻塞读取上限；建议不超过 2000ms，以保证快速停机
MQ_BLOCK_MS=1000
# 消息默认最大重试次数（发布时可逐条覆盖）
MQ_MAX_RETRIES=3
# DLQ 消息保留天数；超过该天数的死信由启动后的定时清理任务移除（0 = 关闭清理）
DLQ_RETENTION_DAYS=7
# 并发槽满载时 defer 返回前的短暂退避（ms），避免 claim/requeue/xadd 自旋
QUEUE_DEFER_BACKOFF_MS=75

# 单个 DAG 子任务超时、跨实例取消轮询周期、每个执行保留的 SSE 事件数
EXECUTION_TASK_TIMEOUT_MS=300000
EXECUTION_POLL_INTERVAL_MS=1000
EXECUTION_EVENT_MAX_LENGTH=10000
# 单进程并发执行上限（2G 内存单进程部署：query 默认 4，design 默认 1；调高需更多内存）
QUERY_MAX_INFLIGHT=4
DESIGN_MAX_INFLIGHT=1
# SSE 进度事件 drain 轮询间隔（ms）、中止任务部分输出回收宽限（ms）
EXECUTION_EVENT_DRAIN_INTERVAL_MS=200
EXECUTION_IN_FLIGHT_PARTIAL_TIMEOUT_MS=2000
# 黑板缓存逐出扫描间隔（ms）、需求文本长度上限（字符）、SSE 单次恢复重放上限
BLACKBOARD_EVICT_INTERVAL_MS=60000
CONSOLE_MAX_REQUIREMENT_CHARS=50000
SSE_REPLAY_LIMIT=1000

# ─── Query FAQ 快路径（Knowledge Hub kb_faq_match 短路 LLM）────────────────
# 总开关；默认关闭，命中高置信 FAQ 时直接返回答案
FAQ_ENABLED=false
# 本仓命中阈值（0–1）；仅 score >= threshold 且 answer 非空才短路
FAQ_THRESHOLD=0.82
# 单次 FAQ 匹配超时（毫秒）
FAQ_TIMEOUT_MS=800
# MCP 工具名（Knowledge Hub 提供 kb_faq_match）
FAQ_TOOL_NAME=kb_faq_match
# 指标门禁（flywheel 01-P4，默认 true）：开启时即使 FAQ_ENABLED=true 也强制关闭快路径，
# 直到观测台（agent-observe）确认 FAQ 命中率 >= 70% 且无"错命中"反馈；
# 仅当有指标支撑时显式设为 false 才能绕过该门禁（启动时会打印告警说明）
FAQ_REQUIRE_METRICS=true

# ─── MCP (模型上下文协议) 客户端 ──────────────────────────────────
# 启用后，智能体将在启动时连接到外部 MCP 服务器，
# 并将它们的工具开放给所有智能体（子智能体 + 查询智能体）。
# 知识库的读取功能就是通过 Knowledge Hub MCP 服务器以这种方式提供的。
# 单个服务器连接失败会记录日志，但不会阻塞系统启动。
MCP_ENABLED=true
# MCP_SERVERS 是一个 JSON 数组。每个条目包含：
#   { "name", "transport": "stdio"|"sse"|"http", "enabled": true,
#     "toolPrefix": "",                             # 可选；Knowledge Hub 工具名已是 kb_*，勿再加 kb_ 前缀（否则会变成 kb_kb_search）
#     "command", "args", "env",                     # stdio 传输协议使用
#     "url", "headers" }                            # sse/http 传输协议使用
# 示例 (基于流式 HTTP 的 Knowledge Hub) — 不要设置 toolPrefix（工具已带 kb_）：
# MCP_SERVERS=[{"name":"knowledge-hub","transport":"http","enabled":true,"url":"http://localhost:4174/mcp","headers":{"Authorization":"Bearer <token>"}}]
# 示例 (本地 stdio MCP 服务器):
# MCP_SERVERS=[{"name":"local-tools","transport":"stdio","enabled":true,"command":"node","args":["./mcp-server.js"]}]
MCP_SERVERS=[{"name":"knowledge-hub","transport":"http","enabled":true,"url":"http://localhost:4174/mcp","headers":{"Authorization":"Bearer <KH_JWT_TOKEN>"}}]

# MCP 工具暴露策略：
#   on_demand（默认）= 仅 defaultExposePrefixes ∪ skill/task 白名单
#   all = 全量注入所有子 Agent / QueryAgent（旧行为）
MCP_EXPOSE_MODE=on_demand
# on_demand 下默认暴露的前缀（逗号分隔）。设为空字符串则不默认暴露任何 MCP 工具。
MCP_DEFAULT_EXPOSE_PREFIXES=kb_
# 可选：按 skill 名追加 MCP 工具模式（JSON 对象 skillName → string[]）
# MCP_SKILL_TOOL_ALLOWLIST={"combat-design":["kb_*"]}
MCP_SKILL_TOOL_ALLOWLIST=

# 显式绑定 Knowledge Hub 项目（注入每个 kb_* 工具的 projectId）。多项目必填，避免静默 default_project。
# MCP_PROJECT_ID=default_project
# MCP 健康（已加载 kb_search）时默认禁用本地 wiki/grep/kg，避免双源；设为 false 可保留本地降级。
# MCP_DISABLE_LOCAL_KNOWLEDGE_WHEN_HEALTHY=true

# ─── 工具组开关 ──────────────────────────────────────────────────
# 工具组用于快速启用/禁用一组相关工具。
# 可用工具组：
#   - knowledge: 本地知识库工具（wiki_lookup, wiki_read, wiki_list, grep_search, kg_*）
#   - web: 网络搜索工具（tavily_search, tavily_extract）
#   - workspace: 工作区文件工具（workspace_read, workspace_list）
# 
# 规则：
#   - 留空（默认）= 启用所有工具组
#   - 指定值 = 只启用列出的工具组，其他组被禁用
#   - 例如：ENABLED_TOOL_GROUPS=web,workspace 将禁用本地知识库工具
#
# 当你将知识库工具迁移到 MCP 后，可以设置 ENABLED_TOOL_GROUPS= 来禁用本地知识库
ENABLED_TOOL_GROUPS=

# ─── Prompt / Skill / Workflow 版本化 (MVCC) ───────────────────────
# 启用后会话创建时绑定 artifact 版本快照；支持灰度发布与秒级回滚
VERSIONING_ENABLED=false
# 新版本默认灰度比例 (0-100)；0=发布时需显式指定 canaryPercent
VERSIONING_DEFAULT_CANARY_PERCENT=0

# ─── Docker 部署 ───────────────────────────────────────────────────
# 映射到宿主机的端口
BACKEND_PORT=13000
FRONTEND_PORT=3001
REDIS_PORT=6379

# ─── 前端 (Next.js) ────────────────────────────────────────────────
# Next.js API 代理到后端的内部 URL
# 本地开发环境: http://localhost:4527
# Docker 环境: http://backend:3000
API_BASE_URL=http://localhost:4527